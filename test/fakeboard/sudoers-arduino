# Like the UNO Q image (/etc/sudoers.d/90-arduino-sysupgrade and friends): a password for anything
# else, but none for the system-update and board-naming commands App Lab runs.
arduino ALL=(ALL) ALL
arduino ALL=(ALL) NOPASSWD: /usr/bin/apt-get update, /usr/sbin/needrestart -r a, /usr/bin/dpkg --configure -a, /usr/bin/apt-get install --only-upgrade -y *, /usr/bin/apt-get clean -y, /usr/bin/hostnamectl set-hostname *
arduino ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop avahi-daemon, /usr/bin/systemctl start avahi-daemon
# /etc/sudoers.d/10-arduino-passwd: setting a new password needs no password.
#1000 ALL=(ALL) NOPASSWD: /usr/local/bin/arduino-passwd
# /etc/sudoers.d/20-arduino-ssh: App Lab's first setup turns SSH on with these.
#1000 ALL=(ALL) NOPASSWD: /usr/sbin/dpkg-reconfigure openssh-server, /usr/bin/systemctl enable ssh, /usr/bin/systemctl start ssh, /usr/bin/systemctl disable ssh, /usr/bin/systemctl stop ssh, /usr/bin/systemctl enable avahi-daemon
